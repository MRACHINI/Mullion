<Window x:Class="Mullion.UI.ArrangeOverlay"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Mullion.UI"
        Title="Mullion arrange windows"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="BannerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#77FFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#66FFFFFF" />
                    <Setter Property="Background" Value="#1AFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <ui:ArrangeSurface x:Name="Surface" />

        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
                Background="#F0111827" CornerRadius="12" Padding="18,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" MinWidth="220" MaxWidth="460">
                        <TextBlock x:Name="CounterText" Foreground="#FFFBBF24" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="BackButton" Style="{StaticResource BannerButton}" Margin="22,0,0,0"
                            Content="Back" Click="OnBackClick" VerticalAlignment="Center" />
                    <Button Style="{StaticResource BannerButton}" Content="Skip" Click="OnSkipClick" VerticalAlignment="Center" />
                    <Button Style="{StaticResource BannerButton}" Content="Done" Click="OnDoneClick" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" Foreground="#CCFFFFFF" FontSize="12"
                           Text="Click a zone to put this window there. Right-click or Space skips it; Esc finishes." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
