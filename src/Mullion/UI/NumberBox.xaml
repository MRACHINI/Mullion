<UserControl x:Class="Mullion.UI.NumberBox"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="Arrow" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="60" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF4B5563" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE5E7EB" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFD1D5DB" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FFD1D5DB" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Frame" Background="White" BorderBrush="#FF9CA3AF" BorderThickness="1" CornerRadius="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Box"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="6,3,4,3"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     MaxLength="4"
                     InputMethod.IsInputMethodEnabled="False"
                     PreviewTextInput="OnPreviewTextInput"
                     PreviewKeyDown="OnPreviewKeyDown"
                     PreviewMouseWheel="OnPreviewMouseWheel"
                     TextChanged="OnTextChanged"
                     GotKeyboardFocus="OnGotFocus"
                     LostKeyboardFocus="OnLostFocus" />

            <Border Grid.Column="1" BorderBrush="#FFD1D5DB" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <RepeatButton x:Name="UpButton" Style="{StaticResource Arrow}" Click="OnUpClick"
                                  AutomationProperties.Name="Increase">
                        <Path Data="M 0 4 L 4 0 L 8 4 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
                    </RepeatButton>
                    <RepeatButton x:Name="DownButton" Grid.Row="1" Style="{StaticResource Arrow}" Click="OnDownClick"
                                  AutomationProperties.Name="Decrease">
                        <Path Data="M 0 0 L 8 0 L 4 4 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
                    </RepeatButton>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
