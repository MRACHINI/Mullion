<Window x:Class="Mullion.UI.ZoneEditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Mullion.UI"
        Title="Zone"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/mullion.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#FFF7F7F8">
    <StackPanel Margin="22,18,22,20">

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Name" />
            <TextBox x:Name="NameBox" Grid.Column="1" Padding="6,4" MaxLength="40" VerticalContentAlignment="Center" />
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Grid" />
            <ui:NumberBox x:Name="ColumnsBox" Grid.Column="1" Width="78" Minimum="1"
                          AutomationProperties.Name="Zone columns" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,16,0" Foreground="#FF6B7280" Text="columns" />
            <ui:NumberBox x:Name="RowsBox" Grid.Column="3" Width="78" Minimum="1"
                          AutomationProperties.Name="Zone rows" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#FF6B7280" Text="rows" />
        </Grid>

        <ui:ZonePicker x:Name="Picker" Height="256" Cursor="Cross" />
        <TextBlock x:Name="SelectionText" Margin="0,6,0,14" Foreground="#FF6B7280" TextWrapping="Wrap"
                   Text="Drag across the picture to choose the cells." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Shortcut" />
            <ui:HotkeyBox x:Name="ShortcutBox" Grid.Column="1" Padding="6,4" VerticalContentAlignment="Center"
                          AutomationProperties.Name="Shortcut" />
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="12,4" Content="Clear" Click="OnClearClick" />
        </Grid>
        <TextBlock x:Name="ShortcutHint" Margin="90,6,0,0" TextWrapping="Wrap" Foreground="#FF6B7280"
                   Text="Click the box and press the keys, for example Ctrl+Alt+1." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Padding="20,5" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveButton" Padding="24,5" Content="Save" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
