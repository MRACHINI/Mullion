<Window x:Class="Mullion.UI.RuleEditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/mullion.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#FFF7F7F8">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="120,4,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,20">

        <Border x:Name="RememberedNote" Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,16" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#FF1E3A8A" FontSize="12"
                       Text="Mullion remembered this from where you last placed the program's window. Saving it here makes it a rule of your own, which Mullion will no longer change." />
        </Border>

        <TextBlock FontWeight="SemiBold" Text="Which windows" />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Open window" />
            <ComboBox x:Name="WindowPicker" Grid.Column="1" SelectionChanged="OnWindowPicked"
                      AutomationProperties.Name="Open window" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Optional: choose a window that is open now to fill in its program below." />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Program" />
            <TextBox x:Name="ProgramBox" Grid.Column="1" Padding="6,4" MaxLength="120" VerticalContentAlignment="Center"
                     TextChanged="OnTextChanged" AutomationProperties.Name="Program" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}"
                   Text="The program's name as Task Manager shows it, for example notepad++ or chrome." />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Title contains" />
            <TextBox x:Name="TitleBox" Grid.Column="1" Padding="6,4" MaxLength="120" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Title contains" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Leave empty for every window of the program, or type part of a title to pick out particular ones." />

        <TextBlock FontWeight="SemiBold" Margin="0,22,0,0" Text="Where they go" />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Zone" />
            <ComboBox x:Name="ZonePickerBox" Grid.Column="1" SelectionChanged="OnSelectionChanged"
                      AutomationProperties.Name="Zone" />
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Monitor" />
            <ComboBox x:Name="MonitorBox" Grid.Column="1" AutomationProperties.Name="Monitor" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Padding="20,5" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveButton" Padding="24,5" Content="Save" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
