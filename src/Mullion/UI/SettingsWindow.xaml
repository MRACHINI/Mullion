<Window x:Class="Mullion.UI.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Mullion.UI"
        Title="Mullion settings"
        Width="540"
        Height="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/mullion.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#FFF7F7F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#FF374151" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="#FF9CA3AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="ColorBox" TargetType="TextBox">
            <Setter Property="Width" Value="78" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="MaxLength" Value="7" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,14">

        <Grid DockPanel.Dock="Bottom" Margin="4,14,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" Text="{Binding Version}" />
            <Button Grid.Column="1" Padding="14,5" Margin="0,0,8,0" Content="Reset to defaults" Click="OnResetClick"
                    ToolTip="Puts every option back to its original value. Your zones are kept." />
            <Button Grid.Column="2" Padding="22,5" Content="Close" IsCancel="True" Click="OnCloseClick" />
        </Grid>

        <TabControl x:Name="Tabs" Background="#FFF7F7F8">

            <TabItem Header="Grid">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0,16,14">
                        <TextBlock Style="{StaticResource Section}" Text="Grid" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="While dragging a window, right-click to show the grid. Release the right button to fix the first corner, move to stretch the selection, then release the left button. The mouse wheel makes the grid finer or coarser; Esc cancels." />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Columns" />
                            <ui:NumberBox Grid.Column="1" Width="84" HorizontalAlignment="Left" Margin="8,0"
                                          Minimum="1" Maximum="{Binding MaxGridSize}" Value="{Binding Columns}"
                                          AutomationProperties.Name="Columns" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Rows" />
                            <ui:NumberBox Grid.Column="1" Width="84" HorizontalAlignment="Left" Margin="8,0"
                                          Minimum="1" Maximum="{Binding MaxGridSize}" Value="{Binding Rows}"
                                          AutomationProperties.Name="Rows" />
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="Margins" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Gap between windows" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1"
                                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4" Value="{Binding WindowGap}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding WindowGap, StringFormat={}{0} px}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Gap at screen edges" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1"
                                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4" Value="{Binding EdgeGap}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding EdgeGap, StringFormat={}{0} px}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="Move on the grid" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Hold this key while dragging a window to snap it to grid lines without changing its size." />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Key" />
                            <ComboBox Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,0"
                                      ItemsSource="{Binding SnapModifiers}" SelectedItem="{Binding SnapMoveModifier}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Zones">
                <DockPanel Margin="16,0,16,14">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Section}" Text="Zones" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="A zone is a part of the screen with a keyboard shortcut. Press the shortcut and the active window moves there." />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button HorizontalAlignment="Left" Padding="16,5" Content="Add zone…" Click="OnAddZoneClick" />
                        <CheckBox Margin="0,14,0,0" IsChecked="{Binding CycleMonitors}"
                                  Content="Pressing a shortcut again moves the window to the next monitor" />
                    </StackPanel>

                    <Border BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="4" Background="White">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF6B7280"
                                       Text="No zones yet. Choose “Add zone…” to make the first one.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasZones}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Zones}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ui:ZonePicker Width="64" Height="36" IsReadOnly="True" VerticalAlignment="Center"
                                                                   Columns="{Binding Columns}" Rows="{Binding Rows}"
                                                                   Span="{Binding Span, Mode=OneWay}" />

                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                        <TextBlock Foreground="#FF6B7280" FontSize="12" Text="{Binding Description}" />
                                                        <TextBlock Foreground="#FFB45309" FontSize="12" TextWrapping="Wrap"
                                                                   Text="Shortcut taken over from another program while Mullion runs."
                                                                   Visibility="{Binding ShortcutTakenOver, Converter={StaticResource Visible}}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" Padding="8,3"
                                                            CornerRadius="4" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FFEFF6FF" />
                                                                <Setter Property="BorderBrush" Value="#FFBFDBFE" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasShortcut}" Value="False">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="12" Text="{Binding ShortcutText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#FF1D4ED8" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasShortcut}" Value="False">
                                                                            <Setter Property="Foreground" Value="#FF9CA3AF" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <Button Grid.Column="3" VerticalAlignment="Center" Padding="12,3" Margin="0,0,6,0"
                                                            Content="Edit" Click="OnEditZoneClick" />
                                                    <Button Grid.Column="4" VerticalAlignment="Center" Padding="12,3"
                                                            Content="Delete" Click="OnDeleteZoneClick" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0,16,14">
                        <TextBlock Style="{StaticResource Section}" Text="Grid overlay" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Background tint" />
                            <TextBox Grid.Column="1" Style="{StaticResource ColorBox}" Margin="8,0,0,0"
                                     Text="{Binding TintColor, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Grid.Column="2" Style="{StaticResource Swatch}" Background="{Binding TintBrush}" />
                            <Slider Grid.Column="3" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding TintOpacity}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Value}" Text="{Binding TintOpacity, StringFormat={}{0:P0}}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Grid lines" />
                            <TextBox Grid.Column="1" Style="{StaticResource ColorBox}" Margin="8,0,0,0"
                                     Text="{Binding LineColor, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Grid.Column="2" Style="{StaticResource Swatch}" Background="{Binding LineBrush}" />
                            <Slider Grid.Column="3" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding LineOpacity}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Value}" Text="{Binding LineOpacity, StringFormat={}{0:P0}}" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Selection" />
                            <TextBox Grid.Column="1" Style="{StaticResource ColorBox}" Margin="8,0,0,0"
                                     Text="{Binding SelectionColor, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Grid.Column="2" Style="{StaticResource Swatch}" Background="{Binding SelectionBrush}" />
                            <Slider Grid.Column="3" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding SelectionOpacity}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Value}" Text="{Binding SelectionOpacity, StringFormat={}{0:P0}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Colours are written as #RRGGBB." />
                        <CheckBox Margin="0,10,0,0" Content="Show the selection size on the grid" IsChecked="{Binding ShowSizeLabel}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="General">
                <StackPanel Margin="16,0,16,14">
                    <TextBlock Style="{StaticResource Section}" Text="General" />
                    <CheckBox Content="Start Mullion when I sign in to Windows" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0"
                               Text="Mullion keeps its settings in settings.json, in the same folder as Mullion.exe." />
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
