<Window x:Class="Mullion.UI.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mullion settings"
        Width="480"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/mullion.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#FFF7F7F8">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#FF374151" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="#FF9CA3AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="ColorBox" TargetType="TextBox">
            <Setter Property="Width" Value="78" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="MaxLength" Value="7" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,6,22,20">

        <TextBlock Style="{StaticResource Section}" Text="Grid" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="While dragging a window, right-click to show the grid. Release the right button to fix the first corner, move to stretch the selection, then release the left button. The mouse wheel makes the grid finer or coarser; Esc cancels." />
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Columns" />
            <Slider Grid.Column="1" Minimum="1" Maximum="{Binding MaxGridSize}" TickFrequency="1"
                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" Value="{Binding Columns}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Columns}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Rows" />
            <Slider Grid.Column="1" Minimum="1" Maximum="{Binding MaxGridSize}" TickFrequency="1"
                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" Value="{Binding Rows}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Rows}" />
        </Grid>

        <TextBlock Style="{StaticResource Section}" Text="Margins" />
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Gap between windows" />
            <Slider Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1"
                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4" Value="{Binding WindowGap}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding WindowGap, StringFormat={}{0} px}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Gap at screen edges" />
            <Slider Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1"
                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4" Value="{Binding EdgeGap}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding EdgeGap, StringFormat={}{0} px}" />
        </Grid>

        <TextBlock Style="{StaticResource Section}" Text="Move on the grid" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Hold this key while dragging a window to snap it to grid lines without changing its size." />
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Key" />
            <ComboBox Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,0"
                      ItemsSource="{Binding SnapModifiers}" SelectedItem="{Binding SnapMoveModifier}" />
        </Grid>

        <TextBlock Style="{StaticResource Section}" Text="Appearance" />
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Background tint" />
            <TextBox Grid.Column="1" Style="{StaticResource ColorBox}" Margin="8,0,0,0"
                     Text="{Binding TintColor, UpdateSourceTrigger=PropertyChanged}" />
            <Border Grid.Column="2" Style="{StaticResource Swatch}" Background="{Binding TintBrush}" />
            <Slider Grid.Column="3" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                    Value="{Binding TintOpacity}" />
            <TextBlock Grid.Column="4" Style="{StaticResource Value}" Text="{Binding TintOpacity, StringFormat={}{0:P0}}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Grid lines" />
            <TextBox Grid.Column="1" Style="{StaticResource ColorBox}" Margin="8,0,0,0"
                     Text="{Binding LineColor, UpdateSourceTrigger=PropertyChanged}" />
            <Border Grid.Column="2" Style="{StaticResource Swatch}" Background="{Binding LineBrush}" />
            <Slider Grid.Column="3" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                    Value="{Binding LineOpacity}" />
            <TextBlock Grid.Column="4" Style="{StaticResource Value}" Text="{Binding LineOpacity, StringFormat={}{0:P0}}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Selection" />
            <TextBox Grid.Column="1" Style="{StaticResource ColorBox}" Margin="8,0,0,0"
                     Text="{Binding SelectionColor, UpdateSourceTrigger=PropertyChanged}" />
            <Border Grid.Column="2" Style="{StaticResource Swatch}" Background="{Binding SelectionBrush}" />
            <Slider Grid.Column="3" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                    Value="{Binding SelectionOpacity}" />
            <TextBlock Grid.Column="4" Style="{StaticResource Value}" Text="{Binding SelectionOpacity, StringFormat={}{0:P0}}" />
        </Grid>
        <CheckBox Margin="0,8,0,0" Content="Show the selection size on the grid" IsChecked="{Binding ShowSizeLabel}" />

        <TextBlock Style="{StaticResource Section}" Text="General" />
        <CheckBox Content="Start Mullion when I sign in to Windows" IsChecked="{Binding StartWithWindows}" />

        <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" Text="{Binding Version}" />
            <Button Grid.Column="1" Padding="14,5" Margin="0,0,8,0" Content="Reset to defaults" Click="OnResetClick" />
            <Button Grid.Column="2" Padding="22,5" Content="Close" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
        </Grid>
    </StackPanel>
</Window>
